# Copy this file to ".env" and fill in your own values before starting.
# Never commit or share the real ".env" file.

# Port the app will be reachable on (http://localhost:PORT)
APP_PORT=8089

# Database credentials (choose strong values)
MYSQL_ROOT_PASSWORD=change_this_password
MYSQL_DATABASE=blog_reviews
MYSQL_USER=reviews
MYSQL_PASSWORD=change_this_password

# Google Books API key (https://console.cloud.google.com/)
GOOGLE_BOOKS_API_KEY=your_api_key_here

# Application settings
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8089

# Published Docker Hub images
PHP_IMAGE=ktistes/blog-recensioni-php:latest
NGINX_IMAGE=ktistes/blog-recensioni-nginx:latest


# Copy this file to ".env" and fill in your own values before starting.
 
# Port the app will be reachable on (http://localhost:PORT)
APP_PORT=8088
 
# Google Books API key (https://console.cloud.google.com/)
GOOGLE_BOOKS_API_KEY=your_api_key_here
 
# Application URL
APP_URL=http://localhost:8088
 
# Outgoing email for the contact form (optional — leave blank to disable)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO_EMAIL=
 
# Published Docker Hub images
PHP_IMAGE=ktistes/book-reviews-php-sqlite:latest
NGINX_IMAGE=ktistes/book-reviews-nginx:latest
 
